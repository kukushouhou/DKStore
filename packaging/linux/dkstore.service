[Unit]
Description=DKStore Cross-Platform Docker App Update Center
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dkstore --listen :8090 --data /var/lib/dkstore
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/dkstore

[Install]
WantedBy=multi-user.target
