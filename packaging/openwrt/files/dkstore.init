#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load 'dkstore'
	local enabled port data_dir
	config_get_bool enabled 'main' 'enabled' 1
	[ "$enabled" -eq 0 ] && return 0

	config_get port 'main' 'port' '8090'
	config_get data_dir 'main' 'data_dir' '/etc/dkstore'

	mkdir -p "$data_dir"
	chmod 700 "$data_dir"
	mkdir -p /var/run/dkstore
	chmod 700 /var/run/dkstore

	procd_open_instance
	procd_set_param command /usr/bin/dkstore --listen ":${port}" --unix-socket /var/run/dkstore/app.sock --data "$data_dir"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/dkstore
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dkstore"
}
